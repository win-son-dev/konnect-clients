# Auth0 (Universal Login) — required at runtime; copy to .env.local and fill in.
# Create a Regular Web Application in the Auth0 dashboard, then read the values
# from its Settings tab. Allowed Callback URLs must include http://localhost:3000/auth/callback.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# 32+ random chars used to encrypt the session cookie. Generate with:
#   openssl rand -hex 32
AUTH0_SECRET=

# Where this app is reachable. Localhost in dev; the deployed URL in prod.
APP_BASE_URL=http://localhost:3000

# The Konnect API audience identifier (matches the API registered in Auth0 for konnect-server).
# Leave blank to skip access-token issuance — sessions still work but you can't call the backend.
AUTH0_AUDIENCE=
